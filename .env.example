# ==========================================
# Telegram AI Priority Filter & Digest Bot
# Configuration Environment Variables
# ==========================================

# 1. Telegram Client (Userbot) Credentials
# Get API_ID and API_HASH from https://my.telegram.org (under 'API Development Tools')
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+85512345678
# Session name (stored as <name>.session)
TELEGRAM_SESSION_NAME=telegram_ai_session
TELEGRAM_BOT_SESSION_NAME=bot_listener_session

# 2. Telegram Notification Bot (Optional but Highly Recommended)
# Create a bot via @BotFather to receive clean instant alerts & digests
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Your personal Telegram User ID or Channel ID where alerts/digests will be sent
# (You can get your ID by messaging @userinfobot)
NOTIFICATION_CHAT_ID=123456789

# 3. AI Model Provider Settings
# Options: "ollama", "gemini", "openai", "openrouter"
AI_PROVIDER=gemini

# If using Ollama (Local or Remote Server - FREE & Private)
# Default local Ollama URL: http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
# If your Ollama server has an API key/proxy, put it here (default is 'ollama')
OLLAMA_API_KEY=ollama

# If using Google Gemini (Optional alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Optional voice output used by future notification channels.
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=

# If using OpenAI / OpenRouter (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. Priority & Digest Rules
# Score threshold (0-100) to immediately ping the user
URGENT_SCORE_THRESHOLD=90
# Priority levels that trigger immediate notification (comma-separated: P0,P1)
IMMEDIATE_ALERT_PRIORITIES=P0,P1

# Digest frequency in hours (e.g. 3 = every 3 hours)
DIGEST_INTERVAL_HOURS=3
# Or specific daily times (24h format, comma-separated e.g. "08:00,13:00,19:00,22:00")
DIGEST_SCHEDULE_TIMES=08:00,13:00,19:00,22:00

# Database path
DATABASE_PATH=telegram_bot.db
# Storage backend for business-assistant state: sqlite (default) or mongo.
STORAGE_BACKEND=mongo
# Required for runtime. Example: mongodb://localhost:27017
MONGO_URI=
MONGO_DATABASE=telegram_business

# 5. Business assistant access and shared AI budget
# Set this to the administrator's numeric Telegram user ID.
OWNER_USER_ID=
# Optional comma-separated IDs. New users must request pairing in Telegram.
APPROVED_USER_IDS=
APPROVED_GROUP_IDS=
AI_MONTHLY_BUDGET_USD=20.0
# Gemini model rates (USD per 1M tokens; verify current provider pricing).
AI_INPUT_PRICE_PER_MILLION=0.30
AI_OUTPUT_PRICE_PER_MILLION=2.50
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3141
# Public HTTPS URL used by the Telegram Web App button (for example https://assistant.example.com)
DASHBOARD_PUBLIC_URL=
ASSISTANT_IDS=business,sales,support
# Optional webhook connectors. Leave blank until the business provider is ready.
INTEGRATION_SECRET=
EMAIL_WEBHOOK_URL=
CALENDAR_WEBHOOK_URL=
CRM_WEBHOOK_URL=
TASK_WEBHOOK_URL=
